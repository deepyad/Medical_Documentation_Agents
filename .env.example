# Copy this file to .env and fill in real values: cp .env.example .env
# See Documentation/SETUP.md for full setup instructions.

# ── Required ─────────────────────────────────────────────────────────────
# No fallback in src/config.py — the app fails immediately at import time if
# this is unset (see Documentation/ARCHITECTURE_DECISIONS.md, I1). Nearly
# everything (agent, RAG, knowledge retrieval) needs a real key.
OPENAI_API_KEY=sk-...

# ── LLM model (optional — defaults to gpt-4-turbo-preview if unset) ────────
# Set this to whatever OpenAI model you actually want to run; the default is
# just what was already hardcoded before this became configurable (see ADR B1).
# OPENAI_MODEL=gpt-4-turbo-preview

# ── LangSmith (optional — only used if you enable tracing/evaluations) ─────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=medical-documentation-agents

# ── Qdrant vector database ──────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=          # optional for local Qdrant, required for Qdrant Cloud

# ── Postgres (optional) ─────────────────────────────────────────────────
# Only required when running the agent in production mode (use_mock_api=False)
# or the MCP server with MCP_SERVER_MODE=production. Mock/eval mode never
# touches this. Uncomment and set once Postgres is running locally (see
# Documentation/SETUP.md) — leave unset otherwise.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medical_documentation

# ── MCP server mode (src/mcp_server.py) ─────────────────────────────────
# "eval" (default if unset) = isolated MockAPI, safe. "production" = real
# Postgres writes — explicit opt-in only.
# MCP_SERVER_MODE=eval

# ── Legacy — declared in src/config.py but not currently read anywhere in
# ── src/ (mode switching happens via use_mock_api / MCP_SERVER_MODE instead).
# ── Left here for completeness; safe to ignore.
MOCK_API_URL=http://localhost:8001
PRODUCTION_API_URL=http://localhost:8000
